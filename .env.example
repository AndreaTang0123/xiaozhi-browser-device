# xiaozhi-browser-device 本地连接配置
#
# 复制本文件为 .env 并填入你自建 xiaozhi-esp32-server 的真实地址。
# .env 已加入 .gitignore，不会被提交；.env.example 只保留占位符，
# 不得填入真实 IP/端口/token。
#
# 本项目只允许连接私有网段 IP 或 localhost（10.x / 172.16-31.x / 192.168.x /
# 127.0.0.1），程序启动时会硬性校验，命中公网地址或域名会直接抛异常拒绝连接。

# 必需：自建 server 的 OTA 接口地址（server.config.yaml 里的 http_port，默认 8003）
# WebSocket 地址不需要单独配置——由 OTA 响应自动下发并覆盖本地配置。
XIAOZHI_OTA_URL=http://<EDGE_IP>:8003/xiaozhi/ota/

# 可选：设备激活协议版本（v1 / v2）。
# 自建 server 的 OTA 响应通常不带 activation 字段，两个值实际效果一样
# （都不会弹激活码 UI）；不确定就留空使用默认 v1。
# XIAOZHI_ACTIVATION_VERSION=v1

# 可选：激活提示里"点击访问"的地址。自建 server 没有网页控制台就留空。
# XIAOZHI_AUTHORIZATION_URL=
